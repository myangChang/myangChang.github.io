{
  "name": "myangchang-blog",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "myangChang 的个人技术博客（Hexo + Fluid）",
  "scripts": {
    "start": "hexo server",
    "dev": "hexo server --draft",
    "clean": "hexo clean",
    "build": "hexo generate",
    "new": "hexo new post",
    "publish": "hexo clean && hexo generate && git add docs && git commit -m \"chore: 重新生成站点\" && git push"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-fluid": "^1.9.9"
  }
}
